# Harbor Taskfile Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Registry Configuration
# =============================================================================

# Container registry to push images to
REGISTRY=registry.goharbor.io

# Image namespace/project in the registry
# For PRs: harbor-next
# For main: harbor-next
IMAGE_NAMESPACE=harbor-next

# Image tag (defaults to VERSION file content if not set)
# For PRs: pr-123
# For dev: dev
# For releases: v2.15.0
IMAGE_TAG=dev

# Registry authentication (required for pushing images)
# Create a robot account in Harbor with push/pull permissions
REGISTRY_USER=robot$your-robot-account
REGISTRY_PASSWORD=your-token-here

# =============================================================================
# Build Configuration
# =============================================================================

# Enable build cache for faster rebuilds
USE_CACHE=true

# Go build flags
GOBUILD_FLAGS=-buildvcs=false

# =============================================================================
# Signing Configuration
# =============================================================================

# Enable keyless signing (recommended for CI)
# Set to 1 to use Sigstore's public instance
COSIGN_EXPERIMENTAL=1

# For key-based signing (optional)
# COSIGN_PRIVATE_KEY=path/to/cosign.key
# COSIGN_PASSWORD=your-key-password

# =============================================================================
# Test Configuration
# =============================================================================

# PostgreSQL connection for integration tests
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USR=postgres
POSTGRESQL_PWD=root123
POSTGRESQL_DATABASE=registry

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Harbor admin credentials for tests
HARBOR_ADMIN=admin
HARBOR_ADMIN_PASSWD=Harbor12345

# Core secret for inter-service communication
CORE_SECRET=tempString

# Test IP address (for integration tests)
TEST_IP=127.0.0.1

# =============================================================================
# Development Configuration
# =============================================================================

# NPM registry (use private registry if needed)
NPM_REGISTRY=https://registry.npmjs.org/

# Enable debug logging
# DEBUG=true
